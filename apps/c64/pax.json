{
  "name": "c64",
  "title": "Commodore 64",
  "version": "0.1.4",
  "description": "Frodo C64 emulator rebuilt as a current ESPHomeBrew PAX.",
  "author": "Frodo; P4 port by RetroESP32-P4",
  "category": "Emulator",
  "license": "GPL-2.0",
  "about": "Runs Commodore 64 D64 and T64 disk images from the SD card. Place the C64 ROM images in /sd/roms/c64/bios/.",
  "changelog": "0.1.4 adds a persistent in-game button mapper and River Raid preset for both joystick ports. 0.1.3 queues SID audio asynchronously; 0.1.2 detects BASIC READY prompts for LOAD/RUN.",
  "controls": [
    "Default D-pad: C64 joystick ports 1 and 2, plus WASD",
    "Default A/B: joystick fire and Space",
    "Swipe-down menu > Button Mapper: edit controls",
    "Start: C64 Run/Stop",
    "Select: C64 F7",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "Frodo C64",
    "version": "4.2",
    "url": "https://github.com/frodo-emu/Frodo"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/c64/bios/basic.rom",
      "note": "8 KiB BASIC ROM"
    },
    {
      "path": "/sd/roms/c64/bios/kernal.rom",
      "note": "8 KiB KERNAL ROM"
    },
    {
      "path": "/sd/roms/c64/bios/char.rom",
      "note": "4 KiB character ROM"
    },
    {
      "path": "/sd/roms/c64/bios/1541.rom",
      "note": "16 KiB drive ROM"
    },
    {
      "path": "/sd/roms/c64/*.d64",
      "note": "Optional disk; BASIC can run without a disk",
      "optional": true
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:apps/pax_emulator_common",
    "local:apps/pax_emulator_common/compat",
    "local:apps/c64",
    "local:apps/c64/core"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-include",
    "stdint.h",
    "-include",
    "stdbool.h",
    "-DPAPP_C64=1",
    "-DESP32=1",
    "-DFRODO_PC=1",
    "-DLSB_FIRST=1",
    "-DHAVE_USLEEP=1"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:apps/c64/core",
      "files": [
        "1541d64.cpp",
        "1541fs.cpp",
        "1541job.cpp",
        "1541t64.cpp",
        "C64_PC.cpp",
        "CPU1541_PC.cpp",
        "CPUC64_PC.cpp",
        "CIA.cpp",
        "Display.cpp",
        "IEC.cpp",
        "Prefs.cpp",
        "REU.cpp",
        "SID.cpp",
        "VIC.cpp",
        "VIC_table.cpp",
        "UserPort_4Player.cpp"
      ]
    },
    {
      "dir": "local:apps/c64",
      "files": [
        "pax_main.cpp",
        "pax_syscalls.c"
      ],
      "prefix": "c64_"
    },
    {
      "dir": "local:apps/pax_emulator_common",
      "files": [
        "pax_libc.c"
      ],
      "prefix": "common_"
    }
  ],
  "ldflags": [
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true,
  "install_recipe": "install-recipe.json",
  "sdk_headers": [
    "local:esphome/components/pax_loader/psram_app.h"
  ]
}
