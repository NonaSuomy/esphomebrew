{
  "name": "gx4000",
  "title": "Amstrad GX4000",
  "version": "0.1.0",
  "description": "Amstrad GX4000 cartridge emulator. Put a cartridge image in /sd/roms/gx4000/.",
  "author": "RetroESP32-P4 port",
  "category": "Emulator",
  "license": "See the upstream project license.",
  "about": "Amstrad GX4000 cartridge emulator. Put a cartridge image in /sd/roms/gx4000/.",
  "controls": [
    "D-pad: directional input",
    "A / B: primary emulator buttons",
    "Start / Select: emulator controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "Arnold",
    "version": "0.8",
    "url": "https://github.com/Arnold-macOS/Arnold"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/gx4000/*",
      "note": ".cpr or compatible raw cartridge"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:apps/gx4000",
    "local:apps/gx4000/core",
    "local:apps/gx4000/core/z80",
    "local:apps/pax_emulator_common",
    "local:apps/pax_emulator_common/compat_cxx",
    "local:apps/c64",
    "local:apps/_shared/component-includes"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-DCPC_LSB_FIRST=1",
    "-DLESS_MULTS=1",
    "-DCPC_NODEBUGGER=1",
    "-DGX4000_TRIM_NONPLUS=1",
    "-DGX4000_CART_ONLY=1",
    "-include",
    "stdint.h"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:apps/gx4000/core",
      "files": [
        "arnold.c",
        "asic.c",
        "audioevent.c",
        "cpc.c",
        "crtc.c",
        "garray.c",
        "gx4000_stubs.c",
        "memory.c",
        "pal.c",
        "psg.c",
        "psgplay.c",
        "ramrom.c",
        "render.c",
        "render5.c",
        "riff.c",
        "z80/z80.c",
        "z80/z80gen.c"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:apps/gx4000",
      "files": [
        "pax_main.cpp"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:apps/pax_emulator_common",
      "files": [
        "pax_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:apps/c64",
      "files": [
        "pax_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true,
  "install_recipe": "install-recipe.json"
}
