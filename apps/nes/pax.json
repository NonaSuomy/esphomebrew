{
  "name": "nes",
  "title": "NES (nofrendo)",
  "version": "0.6.0",
  "description": "Nintendo Entertainment System emulator as a PSRAM app. Add .nes ROMs under /sd/roms/nes/ or /usb0/roms/nes/.",
  "author": "nofrendo; P4 PAX port by NonaSuomy",
  "category": "Emulator",
  "license": "LGPL-2.0",
  "icon": "icon_nes_platform.png",
  "about": "The classic nofrendo 2.0 NES core running as an ESP32-P4 PAX. The launcher selects a .nes ROM from the configured storage; no ROMs are bundled.",
  "changelog": "0.6.0 swaps NES save/load and video pages inside the shared GAME MENU without closing the overlay, and fixes legacy menu rendering; 0.5.0 adds NES OPTIONS to GAME MENU; 0.3.0 adds per-ROM screenshots and video options; 0.2.0 adds ten SNSS save slots and previews.",
  "controls": [
    "D-pad: D-pad",
    "A / B: A / B",
    "Start / Select: Start / Select",
    "Switch Capture/Picture button: open the slide-down GAME MENU",
    "NES OPTIONS: swap GAME MENU rows for NES controls",
    "Swipe down from the top edge: open GAME MENU",
    "GAME MENU: choose RESUME GAME to return to play",
    "L+R or L3 / on-screen close: quit to launcher",
    "A select; D-pad move; Left/Right adjust; B previous page",
    "Save/load states: 10 per-ROM slots with previews",
    "Options: palette, side crop, 1.5x/2x/2.5x zoom",
    "Screenshot: saves a BMP under /sd/roms/nes/.states/"
  ],
  "requires": [
    {
      "path": "/sd/roms/nes/*",
      "note": ".nes or ZIP"
    }
  ],
  "upstream": {
    "project": "nofrendo",
    "version": "2.0",
    "url": "https://github.com/NonaSuomy/RetroESP32-P4/tree/main/components/nofrendo"
  },
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "b72144c85f74017c8c4bcaaa6d82fe65d8c0a6b5",
    "path": "apps/psram_nes"
  },
  "patches": [
    "local:apps/nes/patches/0001-save-state-core.patch"
  ],
  "includes": [
    "local:apps/nes",
    "local:apps/nes",
    "local:apps/pax_emulator_common",
    "components/psram_app_loader/include",
    "components/nofrendo/include"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DPAPP_NES=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces"
  ],
