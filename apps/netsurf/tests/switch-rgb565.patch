 static inline uint32_t fx_pack(const struct fx_surface *s, int r, int g, int b)
 {
+	if (s->bpp == 2)
+		return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
 	if (s->bgr)
 		return 0xff000000u | (b << 16) | (g << 8) | r;
 	return 0xff000000u | (r << 16) | (g << 8) | b;
 }
 
+/* Pixels can be RGB565 or 32-bit and rows may have padding. */
+static inline uint32_t fx_read(const struct fx_surface *s, const uint8_t *px)
+{
+    if (s->bpp == 2) { uint16_t v; memcpy(&v, px, sizeof(v)); return v; }
+    uint32_t v; memcpy(&v, px, sizeof(v)); return v;
+}
+static inline void fx_write(const struct fx_surface *s, uint8_t *px, uint32_t v)
+{
+    if (s->bpp == 2) { uint16_t p = (uint16_t)v; memcpy(px, &p, sizeof(p)); }
+    else memcpy(px, &v, sizeof(v));
+}
