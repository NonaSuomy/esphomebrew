{
  "name": "ngp",
  "title": "Neo Geo Pocket",
  "version": "0.1.1",
  "description": "Neo Geo Pocket emulator. Put a ROM image in /sd/roms/ngp/.",
  "author": "RetroESP32-P4 port",
  "category": "Emulator",
  "license": "See the upstream project license.",
  "about": "Neo Geo Pocket emulator. Put a ROM image in /sd/roms/ngp/.",
  "controls": [
    "D-pad: directional input",
    "A / B: primary emulator buttons",
    "Start / Select: emulator controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "RACE",
    "url": "https://github.com/Francklin2/RACE"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/ngp/*",
      "note": ".ngp or .ngc"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:apps/ngp",
    "local:apps/ngp/core",
    "local:apps/pax_emulator_common",
    "local:apps/pax_emulator_common/compat_cxx",
    "local:apps/c64",
    "local:apps/_shared/component-includes"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-DNGP_PAPP=1",
    "-DCZ80=1",
    "-DUSE_CZ80=1"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:apps/ngp/core",
      "files": [
        "*.c"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:apps/ngp",
      "files": [
        "pax_main.cpp"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:apps/pax_emulator_common",
      "files": [
        "pax_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:apps/c64",
      "files": [
        "pax_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true,
  "install_recipe": "install-recipe.json",
  "changelog": "0.1.1 updates queued audio playback and PAX menu integration.",
  "sdk_headers": [
    "local:esphome/components/pax_loader/psram_app.h"
  ]
}
