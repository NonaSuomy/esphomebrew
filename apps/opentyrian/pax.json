{
  "name": "opentyrian",
  "title": "OpenTyrian",
  "version": "0.1.0",
  "description": "OpenTyrian PAX port built against the current launcher SDK.",
  "author": "OpenTyrian contributors; RetroESP32-P4 port",
  "category": "Game",
  "license": "See upstream licenses.",
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "b72144c85f74017c8c4bcaaa6d82fe65d8c0a6b5",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:apps/opentyrian/port/compat",
    "local:apps/opentyrian/sdl",
    "local:apps/opentyrian/game"
  ],
  "cflags": [
    "-DPAX_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-fno-tree-loop-distribute-patterns",
    "-Wno-implicit-function-declaration",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types"
  ],
  "groups": [
    {
      "dir": "local:apps/opentyrian/game",
      "files": [
        "animlib.c",
        "arg_parse.c",
        "backgrnd.c",
        "config.c",
        "config_file.c",
        "destruct.c",
        "editship.c",
        "episodes.c",
        "file.c",
        "font.c",
        "fonthand.c",
        "game_menu.c",
        "helptext.c",
        "joystick.c",
        "jukebox.c",
        "keyboard.c",
        "lds_play.c",
        "loudness.c",
        "lvllib.c",
        "lvlmast.c",
        "mainint.c",
        "menus.c",
        "mouse.c",
        "mtrand.c",
        "musmast.c",
        "network.c",
        "nortsong.c",
        "nortvars.c",
        "opentyr.c",
        "opl.c",
        "palette.c",
        "params.c",
        "pcxload.c",
        "pcxmast.c",
        "picload.c",
        "player.c",
        "scroller.c",
        "setup.c",
        "shots.c",
        "sizebuf.c",
        "sndmast.c",
        "sprite.c",
        "starlib.c",
        "std_support.c",
        "tyrian2.c",
        "varz.c",
        "vga256d.c",
        "vga_palette.c",
        "video.c",
        "video_scale.c",
        "video_scale_hqNx.c",
        "xmas.c"
      ],
      "prefix": "game_"
    },
    {
      "dir": "local:apps/opentyrian/port",
      "files": [
        "pax_main.c",
        "pax_sdl_video.c",
        "pax_sdl_audio.c",
        "pax_sdl_event.c",
        "pax_sdl_system.c",
        "pax_syscalls.c"
      ],
      "prefix": "port_"
    }
  ],
  "newlib": true,
  "requires": [
    {
      "path": "/sd/tyrian/data/tyrian1.lvl",
      "note": "Tyrian 2.1 game data; this port uses /sd/tyrian/data"
    },
    {
      "path": "/sd/tyrian/data/tyrian.hdt",
      "note": "Tyrian 2.1 item data"
    }
  ],
  "install_recipe": "install-recipe.json",
  "publish": true,
  "sdk_headers": [
    "local:esphome/components/pax_loader/psram_app.h"
  ]
}
