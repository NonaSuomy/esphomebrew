 #include <istream>
 #include <miniz.h>
 
 namespace {
+#if defined(PAX_APP_SIDE)
+class MinizEntryBuffer : public std::streambuf {
+    mz_zip_reader_extract_iter_state *state;
+    std::array<char, 4096> bytes;
+    bool verified = false;
+  public:
+    explicit MinizEntryBuffer(mz_zip_reader_extract_iter_state *s) : state(s) {}
+    ~MinizEntryBuffer() override { finish(); }
+    bool finish() {
+        if (state) {
+            verified = mz_zip_reader_extract_iter_free(state) != 0;
+            state = nullptr;
+        }
+        return verified;
+    }
+  protected:
+    int_type underflow() override {
+        if (gptr() && gptr() < egptr()) return traits_type::to_int_type(*gptr());
+        const size_t n = state ? mz_zip_reader_extract_iter_read(state, bytes.data(), bytes.size()) : 0;
+        if (!n) return traits_type::eof();
+        setg(bytes.data(), bytes.data(), bytes.data() + n);
+        return traits_type::to_int_type(*gptr());
+    }
+};
+class MinizEntryStream : public ZipEntryStream {
+    MinizEntryBuffer buffer;
+  public:
+    explicit MinizEntryStream(mz_zip_reader_extract_iter_state *state) : buffer(state) {
+        rdbuf(&buffer); clear();
+    }
+    bool finish() override { return buffer.finish(); }
+};
+#endif
