@@ -14,6 +14,30 @@
 
 ZipProjectLoader::ZipProjectLoader(ProjectFormat format) : format(format) {}
 
+#if defined(PAX_APP_SIDE)
+// A callback keeps at most one target DOM alive. Runtime blocks/lists retain
+// every value, while completed target JSON is discarded before decoding more.
+static nlohmann::json parsePaxProject(const char *data, size_t size,
+                                    ProjectFormat format) {
+    bool targets = false;
+    auto consume = [&](int depth, nlohmann::json::parse_event_t event,
+                       nlohmann::json &value) {
+        using Event = nlohmann::json::parse_event_t;
+        if (depth == 1 && event == Event::key)
+            targets = format == ProjectFormat::SB3 && value == "targets";
+        if (targets && depth == 2 && event == Event::object_end) {
+            Parser::loadSb3Target(std::move(value));
+            return false;
+        }
+        if (targets && depth == 1 && event == Event::array_end)
+            targets = false;
+        return true;
+    };
+    // Parse the extraction buffer directly, avoiding a full-size string copy.
+    return nlohmann::json::parse(data, data + size, consume, false);
+}
+#endif
