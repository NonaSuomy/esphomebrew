 ZipProjectLoader::ZipProjectLoader(ProjectFormat format) : format(format) {}
 
+#if defined(PAX_APP_SIDE)
+// A callback keeps at most one target DOM alive. Runtime blocks/lists retain
+// every value, while completed target JSON is discarded before decoding more.
+static nlohmann::json parsePaxProject(std::istream &input, ProjectFormat format) {
+    bool targets = false, inLists = false, inItems = false;
+    std::string listId;
+    Parser::Sb3SavedLists lists;
+    std::unordered_map<std::string, std::shared_ptr<const std::string>> strings;
+    auto consume = [&](int depth, nlohmann::json::parse_event_t event,
+                       nlohmann::json &value) {
+        using Event = nlohmann::json::parse_event_t;
+        if (depth == 1 && event == Event::key)
+            targets = format == ProjectFormat::SB3 && value == "targets";
+        if (targets && depth == 2 && event == Event::object_start) {
+            lists.clear(); inLists = inItems = false;
+        }
+        if (targets && depth == 3 && event == Event::key) {
+            inLists = value == "lists";
+            if (inLists) lists.clear();
+        }
+        if (inLists && depth == 4 && event == Event::key)
+            listId = value.get<std::string>();
+        if (inLists && depth == 5 && event == Event::array_start) {
+            inItems = true;
+            lists[listId].clear();
+            strings.clear();
+        }
+        if (inItems && depth == 6 &&
+            (event == Event::value || event == Event::object_end || event == Event::array_end)) {
+            auto &items = lists[listId];
+            if (value.is_string()) {
+                const auto &text = value.get_ref<const std::string &>();
+                auto found = strings.find(text);
+                if (found != strings.end()) items.emplace_back(found->second);
+                else if (text.size() <= 64 && strings.size() < 256) {
+                    auto shared = std::make_shared<const std::string>(text);
+                    strings.emplace(text, shared);
+                    items.emplace_back(std::move(shared));
+                } else items.push_back(Value::fromJson(value));
+            } else items.push_back(Value::fromJson(value));
+            // The runtime owns this entry; don't grow a duplicate JSON array.
+            return false;
+        }
+        if (inItems && depth == 5 && event == Event::array_end) {
+            inItems = false; strings.clear();
+            // Release geometric-growth slack before loading the next target.
+            auto &items = lists[listId];
+            if (items.size() >= 1024) items.shrink_to_fit();
+        }
+        if (inLists && depth == 3 && event == Event::object_end)
+            inLists = false;
+        if (targets && depth == 2 && event == Event::object_end) {
+            const std::string name = value.value("name", std::string("unnamed"));
+            Parser::loadSb3Target(std::move(value), std::move(lists));
+            Log::log("Loaded SB3 target: " + name);
+            return false;
+        }
+        if (targets && depth == 1 && event == Event::array_end)
+            targets = false;
+        return true;
+    };
+    // Decode from a bounded ZIP-entry buffer, never holding the full JSON text.
+    return nlohmann::json::parse(input, consume, false);
+}
+#endif
