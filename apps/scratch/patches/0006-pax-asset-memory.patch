diff --git a/source/runtime/runtime.cpp b/source/runtime/runtime.cpp
index d3937cb..d1608f9 100644
--- a/source/runtime/runtime.cpp
+++ b/source/runtime/runtime.cpp
@@ -930,6 +930,21 @@ void Scratch::loadCurrentCostumeImage(Sprite *sprite) {
     Costume &costume = sprite->costumes[sprite->currentCostume];
     const std::string &costumeName = costume.fullName;
 
+#if defined(PAX_APP_SIDE)
+    // Retain visible costumes and this explicit request (including hidden
+    // stamps). Release old/hidden cached bitmaps before allocating a new one.
+    std::unordered_set<std::string> needed{costumeName};
+    for (auto *active : sprites) {
+        if ((active->isStage || active->visible) && active->currentCostume >= 0 &&
+            static_cast<size_t>(active->currentCostume) < active->costumes.size())
+            needed.insert(active->costumes[active->currentCostume].fullName);
+    }
+    for (auto cached = costumeImages.begin(); cached != costumeImages.end();) {
+        if (!needed.count(cached->first)) cached = costumeImages.erase(cached);
+        else ++cached;
+    }
+#endif
+
     const int screenWidth = Render::getWidth();
     const int screenHeight = Render::renderMode == Render::BOTH_SCREENS ? 480 : Render::getHeight();
 
