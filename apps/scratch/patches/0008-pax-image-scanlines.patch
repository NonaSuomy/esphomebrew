diff --git a/source/pax_image_rows.hpp b/source/pax_image_rows.hpp
new file mode 100644
index 0000000..f3a289e
--- /dev/null
+++ b/source/pax_image_rows.hpp
@@ -0,0 +1,130 @@
+#pragma once
+#include <miniz.h>
+#include <cstring>
+#include <algorithm>
+#include <cstdlib>
+#include <limits>
+
+// Keep the original RGBA samples; identical adjacent rows share immutable data.
+static void paxStoreImageRow(PaxImageRows &image, std::vector<uint8_t> row) {
+    if (!image.rows.empty() && *image.rows.back() == row)
+        image.rows.push_back(image.rows.back());
+    else image.rows.push_back(std::make_shared<std::vector<uint8_t>>(std::move(row)));
+}
+
+static std::shared_ptr<PaxImageRows> paxRasterSvgRows(lunasvg::Document &doc, int width, int height) {
+    auto image = std::make_shared<PaxImageRows>();
+    image->rows.reserve(height);
+    constexpr int bandHeight = 16, guardRows = 4;
+    std::vector<uint8_t> band(static_cast<size_t>(width) * (bandHeight + guardRows * 2) * 4);
+    for (int top = 0; top < height; top += bandHeight) {
+        const int count = std::min(bandHeight, height - top);
+        const int renderTop = std::max(0, top - guardRows);
+        const int renderBottom = std::min(height, top + count + guardRows);
+        lunasvg::Bitmap bitmap(band.data(), width, renderBottom - renderTop, width * 4);
+        bitmap.clear(0);
+        doc.render(bitmap, lunasvg::Matrix(width / doc.width(), 0, 0, height / doc.height(), 0, -renderTop));
+        for (int y = 0; y < count; ++y) {
+            std::vector<uint8_t> row(width * 4);
+            for (int x = 0; x < width; ++x) {
+                auto *src = band.data() + ((y + top - renderTop) * width + x) * 4;
+                auto *dst = row.data() + x * 4;
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+                unsigned a = src[0], r = src[1], g = src[2], b = src[3];
+#else
+                unsigned b = src[0], g = src[1], r = src[2], a = src[3];
+#endif
+                if (a > 0 && a < 255) { r = r * 255 / a; g = g * 255 / a; b = b * 255 / a; }
+                dst[0] = r; dst[1] = g; dst[2] = b; dst[3] = a;
+            }
+            paxStoreImageRow(*image, std::move(row));
+        }
+    }
+    return image;
+}
+
+static uint32_t paxPngU32(const unsigned char *p) {
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+}
+static uint8_t paxPngPaeth(int a, int b, int c) {
+    const int p = a + b - c, pa = std::abs(p - a), pb = std::abs(p - b), pc = std::abs(p - c);
+    return pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
+}
+
+// Stream large noninterlaced 8-bit RGB/RGBA PNGs, rather than asking stb for
+// contiguous inflated and output buffers. Other formats retain the stb path.
+static nonstd::expected<std::shared_ptr<PaxImageRows>, std::string>
+paxDecodePngRows(const unsigned char *data, size_t size, int &width, int &height, bool half) {
+    std::shared_ptr<PaxImageRows> unsupported;
+    const unsigned char signature[] = {137, 80, 78, 71, 13, 10, 26, 10};
+    if (size < 33 || std::memcmp(data, signature, 8) != 0 || std::memcmp(data + 12, "IHDR", 4) != 0)
+        return unsupported;
+    if (paxPngU32(data + 8) != 13) return nonstd::make_unexpected("Invalid PNG header length");
+    const uint32_t w = paxPngU32(data + 16), h = paxPngU32(data + 20);
+    if (w == 0 || h == 0 || w > 16384 || h > 16384)
+        return nonstd::make_unexpected("Invalid PNG dimensions");
+    const int channels = data[25] == 6 ? 4 : data[25] == 2 ? 3 : 0;
+    if (uint64_t(w) * h * 4 <= 256 * 1024 || data[24] != 8 || channels == 0 || data[26] || data[27] || data[28])
+        return unsupported;
+    std::vector<uint8_t> compressed;
+    bool end = false;
+    for (size_t at = 8; at < size;) {
+        if (size - at < 12) return nonstd::make_unexpected("Truncated PNG chunk");
+        const size_t n = paxPngU32(data + at);
+        if (n > size - at - 12) return nonstd::make_unexpected("Invalid PNG chunk length");
+        if (uint32_t(mz_crc32(0, data + at + 4, n + 4)) != paxPngU32(data + at + 8 + n))
+            return nonstd::make_unexpected("PNG chunk CRC mismatch");
+        if (std::memcmp(data + at + 4, "tRNS", 4) == 0) return unsupported;
+        if (std::memcmp(data + at + 4, "IDAT", 4) == 0)
+            compressed.insert(compressed.end(), data + at + 8, data + at + 8 + n);
+        if (std::memcmp(data + at + 4, "IEND", 4) == 0) { end = true; break; }
+        at += n + 12;
+    }
+    if (!end || compressed.empty() || compressed.size() > std::numeric_limits<unsigned int>::max())
+        return nonstd::make_unexpected("Incomplete PNG data");
+    mz_stream stream{};
+    if (mz_inflateInit(&stream) != MZ_OK) return nonstd::make_unexpected("PNG inflater initialization failed");
+    struct EndInflate { mz_stream &s; ~EndInflate() { mz_inflateEnd(&s); } } guard{stream};
+    stream.next_in = compressed.data(); stream.avail_in = compressed.size();
+    width = half ? std::max<uint32_t>(1, w >> 1) : w;
+    height = half ? std::max<uint32_t>(1, h >> 1) : h;
+    auto image = std::make_shared<PaxImageRows>(); image->rows.reserve(height);
+    std::vector<uint8_t> raw(static_cast<size_t>(w) * channels + 1), previous(raw.size() - 1, 0);
+    int status = MZ_OK;
+    for (uint32_t y = 0; y < h; ++y) {
+        stream.next_out = raw.data(); stream.avail_out = raw.size();
+        while (stream.avail_out) {
+            const auto before = stream.total_out;
+            status = mz_inflate(&stream, MZ_NO_FLUSH);
+            if ((status != MZ_OK && status != MZ_STREAM_END) || stream.total_out == before ||
+                (status == MZ_STREAM_END && stream.avail_out))
+                return nonstd::make_unexpected("Truncated or corrupt PNG pixels");
+        }
+        const int filter = raw[0];
+        if (filter > 4) return nonstd::make_unexpected("Invalid PNG row filter");
+        for (size_t x = 0; x < previous.size(); ++x) {
+            const int a = x >= static_cast<size_t>(channels) ? raw[1 + x - channels] : 0;
+            const int b = previous[x], c = x >= static_cast<size_t>(channels) ? previous[x - channels] : 0;
+            const int predicted = filter == 1 ? a : filter == 2 ? b : filter == 3 ? (a + b) / 2 : filter == 4 ? paxPngPaeth(a, b, c) : 0;
+            raw[1 + x] = uint8_t(raw[1 + x] + predicted);
+        }
+        if ((!half || (y % 2 == 0)) && image->rows.size() < static_cast<size_t>(height)) {
+            std::vector<uint8_t> row(width * 4);
+            for (int x = 0; x < width; ++x) {
+                const size_t src = 1 + static_cast<size_t>(half ? x * 2 : x) * channels;
+                row[x * 4] = raw[src]; row[x * 4 + 1] = raw[src + 1]; row[x * 4 + 2] = raw[src + 2];
+                row[x * 4 + 3] = channels == 4 ? raw[src + 3] : 255;
+            }
+            paxStoreImageRow(*image, std::move(row));
+        }
+        std::copy(raw.begin() + 1, raw.end(), previous.begin());
+        if (status == MZ_STREAM_END && y + 1 != h) return nonstd::make_unexpected("PNG ended before final row");
+    }
+    if (status != MZ_STREAM_END) {
+        uint8_t extra; stream.next_out = &extra; stream.avail_out = 1;
+        status = mz_inflate(&stream, MZ_FINISH);
+        if (status != MZ_STREAM_END || stream.avail_out != 1)
+            return nonstd::make_unexpected("PNG pixel length or checksum mismatch");
+    }
+    return image;
+}
