 #if defined(PAX_APP_SIDE)
 struct PaxImageRows {
     std::vector<std::shared_ptr<const std::vector<uint8_t>>> rows;
+    size_t rowBytes = 0;
+    // Only compressed rows borrow this cache; pixel sampling consumes it before
+    // requesting another row. Subrect views share the same immutable storage.
+    mutable std::vector<uint8_t> expanded;
+    mutable const std::vector<uint8_t> *cached = nullptr;
+    const uint8_t *rowData(int y) const {
+        const auto &row = *rows[y];
+        if (row.size() == rowBytes) return row.data();
+        if (cached != &row) {
+            expanded.resize(rowBytes);
+            size_t out = 0;
+            for (size_t at = 0; at < row.size(); at += 6) {
+                const unsigned count = unsigned(row[at]) | unsigned(row[at + 1]) << 8;
+                for (unsigned n = 0; n < count; ++n, out += 4)
+                    memcpy(expanded.data() + out, row.data() + at + 2, 4);
+            }
+            cached = &row;
+        }
+        return expanded.data();
+    }
 };
 #endif
