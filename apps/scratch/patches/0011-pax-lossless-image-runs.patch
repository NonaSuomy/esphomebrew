diff --git a/source/pax_image_rows.hpp b/source/pax_image_rows.hpp
index f3a289e..69d4274 100644
--- a/source/pax_image_rows.hpp
+++ b/source/pax_image_rows.hpp
@@ -5,8 +5,23 @@
 #include <cstdlib>
 #include <limits>
 
-// Keep the original RGBA samples; identical adjacent rows share immutable data.
+// Lossless RGBA runs avoid keeping multi-megabyte flat/striped backdrops.
+// High-entropy rows stay raw; decoding needs only one native-resolution row.
 static void paxStoreImageRow(PaxImageRows &image, std::vector<uint8_t> row) {
+    image.rowBytes = row.size();
+    std::vector<uint8_t> runs;
+    runs.reserve(std::min<size_t>(256, row.size() / 2));
+    bool compress = true;
+    for (size_t at = 0; at < row.size();) {
+        unsigned count = 1;
+        while (count < 65535 && at + (count + 1) * 4 <= row.size() &&
+               std::memcmp(row.data() + at, row.data() + at + count * 4, 4) == 0) ++count;
+        if (runs.size() + 6 >= row.size() / 2) { compress = false; break; }
+        runs.push_back(count & 255); runs.push_back(count >> 8);
+        runs.insert(runs.end(), row.begin() + at, row.begin() + at + 4);
+        at += count * 4;
+    }
+    if (compress) row = std::move(runs);
     if (!image.rows.empty() && *image.rows.back() == row)
         image.rows.push_back(image.rows.back());
     else image.rows.push_back(std::make_shared<std::vector<uint8_t>>(std::move(row)));
