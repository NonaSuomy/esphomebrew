{
  "name": "sms",
  "title": "Sega Master System",
  "version": "0.1.0",
  "description": "Sega Master System and Game Gear emulator. Put an SMS, GG or ZIP ROM in /sd/roms/sms/.",
  "author": "RetroESP32-P4 port",
  "category": "Emulator",
  "license": "See the upstream project license.",
  "about": "Sega Master System and Game Gear emulator. Put an SMS, GG or ZIP ROM in /sd/roms/sms/.",
  "controls": [
    "D-pad: directional input",
    "A / B: primary emulator buttons",
    "Start / Select: emulator controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "SMS Plus",
    "url": "https://github.com/ekeeke/Genesis-Plus-GX"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/sms/*",
      "note": ".sms or .gg (ZIP supported)"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:apps/sms",
    "local:apps/sms/core",
    "local:apps/sms/core/include",
    "local:apps/sms/core/cpu",
    "local:apps/sms/core/sound",
    "local:apps/pax_emulator_common",
    "local:apps/pax_emulator_common/compat",
    "local:apps/c64",
    "local:apps/_shared/component-includes"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-Dsnd=smsplus_snd",
    "-Dsound_reset=smsplus_sound_reset"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:apps/sms/core",
      "files": [
        "config.c",
        "crc32.c",
        "error.c",
        "hvc.c",
        "loadrom.c",
        "memz80.c",
        "pio.c",
        "render.c",
        "render_bp_lut.c",
        "render_lut.c",
        "sms.c",
        "state.c",
        "system.c",
        "tms.c",
        "tms_bp_expand.c",
        "tms_lookup.c",
        "tms_mc_lookup.c",
        "tms_obj_lut.c",
        "tms_txt_lookup.c",
        "vdp.c",
        "cpu/z80.c",
        "cpu/z80_SZHVC_add_table.c",
        "cpu/z80_SZHVC_sub_table.c",
        "sound/emu2413.c",
        "sound/fmintf.c",
        "sound/sn76489.c",
        "sound/sound.c",
        "sound/ym2413.c"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:apps/sms",
      "files": [
        "pax_main.c"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:apps/pax_emulator_common",
      "files": [
        "pax_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:apps/c64",
      "files": [
        "pax_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true,
  "install_recipe": "install-recipe.json"
}
