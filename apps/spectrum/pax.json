{
  "name": "spectrum",
  "title": "ZX Spectrum",
  "version": "0.1.0",
  "description": "ZX Spectrum emulator. Put a TAP, TZX or snapshot image in /sd/roms/spectrum/.",
  "author": "RetroESP32-P4 port",
  "category": "Emulator",
  "license": "See the upstream project license.",
  "about": "ZX Spectrum emulator. Put a TAP, TZX or snapshot image in /sd/roms/spectrum/.",
  "controls": [
    "D-pad: directional input",
    "A / B: primary emulator buttons",
    "Start / Select: emulator controls",
    "Menu: quit to launcher"
  ],
  "upstream": {
    "project": "ESP Spectrum",
    "url": "https://github.com/ralfendrich/ESP32-ZX-Spectrum"
  },
  "icon": "icon.png",
  "requires": [
    {
      "path": "/sd/roms/spectrum/*",
      "note": ".tap, .tzx or supported snapshot"
    }
  ],
  "build": "custom",
  "source": {
    "repo": "https://github.com/NonaSuomy/RetroESP32-P4",
    "ref": "ae04c88d166c55fa60722276ccc1cc50b7d100f2",
    "path": "components/psram_app_loader"
  },
  "includes": [
    "local:apps/spectrum",
    "local:apps/spectrum/core",
    "local:apps/spectrum/core/include",
    "local:apps/pax_emulator_common",
    "local:apps/pax_emulator_common/compat",
    "local:apps/c64",
    "local:apps/_shared/component-includes"
  ],
  "cflags": [
    "-DPAPP_APP_SIDE=1",
    "-DIRAM_ATTR=",
    "-std=gnu99",
    "-O2",
    "-fno-common",
    "-ffunction-sections",
    "-fdata-sections",
    "-Wall",
    "-Wno-format",
    "-Wno-unused-variable",
    "-Wno-unused-function",
    "-Wno-maybe-uninitialized",
    "-Wno-implicit-function-declaration",
    "-Wno-pointer-sign",
    "-Wno-int-conversion",
    "-Wno-incompatible-pointer-types",
    "-Wno-sign-compare",
    "-Wno-missing-braces",
    "-DPAPP_SPECTRUM=1",
    "-DSPECT_MEM=1",
    "-DZ80C=1",
    "-DHAVE_SOUND=1",
    "-include",
    "stdint.h",
    "-include",
    "stdbool.h",
    "-include",
    "esp_attr.h",
    "-include",
    "esp_heap_caps.h"
  ],
  "cxxflags": [
    "-std=gnu++17",
    "-D_Static_assert=static_assert",
    "-fno-exceptions",
    "-fno-rtti",
    "-fno-threadsafe-statics",
    "-fno-use-cxa-atexit",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Wno-write-strings",
    "-Wno-narrowing",
    "-Wno-overloaded-virtual"
  ],
  "groups": [
    {
      "dir": "local:apps/spectrum/core",
      "files": [
        "ay_sound.c",
        "compr.c",
        "interf.c",
        "keynames.c",
        "loadim.c",
        "misc.c",
        "rom_imag.c",
        "snapshot.c",
        "spect.c",
        "spkey.c",
        "spperif.c",
        "spscr.c",
        "spsound.c",
        "sptape.c",
        "stubs.c",
        "tapefile.c",
        "vgakey.c",
        "vgascr.c",
        "z80.c",
        "z80optab.c",
        "z80_op1.c",
        "z80_op2.c",
        "z80_op3.c",
        "z80_op4.c",
        "z80_op5.c",
        "z80_op6.c",
        "z80_step.c"
      ],
      "prefix": "core_"
    },
    {
      "dir": "local:apps/spectrum",
      "files": [
        "pax_main.c"
      ],
      "prefix": "app_"
    },
    {
      "dir": "local:apps/pax_emulator_common",
      "files": [
        "pax_libc.c"
      ],
      "prefix": "common_"
    },
    {
      "dir": "local:apps/c64",
      "files": [
        "pax_syscalls.c"
      ],
      "prefix": "sys_"
    }
  ],
  "ldflags": [
    "-Wl,--allow-multiple-definition",
    "-Wl,--wrap=fopen",
    "-Wl,--wrap=fclose",
    "-Wl,--wrap=fread",
    "-Wl,--wrap=fwrite",
    "-Wl,--wrap=fseek",
    "-Wl,--wrap=ftell",
    "-Wl,--wrap=rewind",
    "-Wl,--wrap=getc",
    "-Wl,--wrap=fgetc",
    "-Wl,--wrap=exit"
  ],
  "newlib": true,
  "install_recipe": "install-recipe.json"
}
