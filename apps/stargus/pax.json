{
  "name": "stargus",
  "title": "Stargus",
  "version": "0.2.0",
  "description": "Stargus code-only PAX port; converted StarCraft assets stay on SD.",
  "category": "Game",
  "about": "Development build. Stratagus-based Stargus port. Requires a separately converted game tree and prepared media/runtime.paxassets, media/menu.paxmenu, media/terrain.paxtile and media/stargus_intro.ogg. No game graphics, music or sound samples are linked into the PAX.",
  "controls": [
    "Mouse or touch: select units and use the game menus",
    "Keyboard: game shortcuts",
    "Hold Menu 3 s: return to the launcher"
  ],
  "canvas": true,
  "build": "custom",
  "source": {
    "repo": "https://github.com/Wargus/stratagus",
    "ref": "3d87c93f7fd8c0b62ee1be5df0a6d9efc72ca6cc",
    "path": "src"
  },
  "linker_script": "local:apps/stargus/psram_app.ld",
  "sdk_headers": [
    "local:esphome/components/pax_loader/psram_app.h"
  ],
  "install_recipe": "install-recipe.json",
  "changelog": "0.2.0: load all game graphics and audio from storage; standalone code-only store build.",
  "publish": true,
  "requires": [
    {
      "path": "/sd/roms/stargus/scripts/stratagus.lua",
      "note": "Startool-converted game scripts"
    },
    {
      "path": "/sd/roms/stargus/graphics",
      "note": "Converted palette/graphics tree"
    },
    {
      "path": "/sd/roms/stargus/sounds",
      "note": "Converted sound tree"
    },
    {
      "path": "/sd/roms/stargus/media/terrain.paxtile",
      "note": "Generate with prepare_stargus_terrain.py from the converted graphics tree"
    },
    {
      "path": "/sd/roms/stargus/media/menu.paxmenu",
      "note": "Generate with prepare_stargus_menu.py from the converted game tree"
    },
    {
      "path": "/sd/roms/stargus/media/*.ogg",
      "note": "Converted menu soundtrack companions, if available",
      "optional": true
    },
    {
      "path": "/sd/roms/stargus/media/runtime.paxassets",
      "note": "Prepared indexed sprite companion"
    },
    {
      "path": "/sd/roms/stargus/media/stargus_intro.ogg",
      "note": "Prepared intro soundtrack"
    }
  ],
