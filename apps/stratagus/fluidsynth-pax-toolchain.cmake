set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER "$ENV{CROSS_COMPILE}gcc")
set(CMAKE_CXX_COMPILER "$ENV{CROSS_COMPILE}g++")
# Hardware F, software calling ABI: identical to the PAX's audio decoder.
if("$ENV{FLUIDSYNTH_PAX_ABI}" STREQUAL "ilp32f")
  set(PAX_FLUID_ABI_FLAGS "-march=rv32imafc_zicsr_zifencei -mabi=ilp32f")
else()
  set(PAX_FLUID_ABI_FLAGS "-march=rv32imaf_zicsr_zifencei -mabi=ilp32")
endif()
set(CMAKE_C_FLAGS_INIT "-Os ${PAX_FLUID_ABI_FLAGS} -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "-Os ${PAX_FLUID_ABI_FLAGS} -ffunction-sections -fdata-sections")
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
