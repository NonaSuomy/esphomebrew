@@ -24,6 +24,12 @@
 
 #include "lauxlib.h"
 
+#ifdef STRATAGUS_PAX
+#include "psram_app.h"
+#include <string.h>
+extern const app_services_t *_pax_svc;
+#endif
+
 
 #define FREELIST_REF	0	/* free list of references */
 
@@ -626,6 +632,22 @@ LUALIB_API int (luaL_loadstring) (lua_State *L, const char *s) {
 
 static void *l_alloc (void *ud, void *ptr, size_t osize, size_t nsize) {
   (void)ud;
+#ifdef STRATAGUS_PAX
+  if (!_pax_svc) return NULL;
+  if (nsize == 0) {
+    if (ptr && _pax_svc->mem_free) _pax_svc->mem_free(ptr);
+    return NULL;
+  }
+  /* Do not use the launcher realloc callback here.  Lua frequently grows
+  ** small adjacent objects, while the PAX heap may move between internal
+  ** RAM and PSRAM; explicit copy/free keeps the old-size contract intact. */
+  void *next = _pax_svc->mem_caps_alloc ?
+    _pax_svc->mem_caps_alloc(nsize, PAX_MEM_CAP_SPIRAM) :
+    (_pax_svc->mem_alloc ? _pax_svc->mem_alloc(nsize) : NULL);
+  if (next && ptr && osize) memcpy(next, ptr, osize < nsize ? osize : nsize);
+  if (ptr && _pax_svc->mem_free) _pax_svc->mem_free(ptr);
+  return next;
+#else
   (void)osize;
   if (nsize == 0) {
     free(ptr);
@@ -633,6 +655,7 @@ static void *l_alloc (void *ud, void *ptr, size_t osize, size_t nsize) {
   }
   else
     return realloc(ptr, nsize);
+#endif
 }
 
 
