+bool MIPI_DSI::draw_scaled_rgb565(int x, int y, int out_w, int out_h, const uint16_t *source, int in_w, int in_h,
+                                  const uint8_t **presented) {
+  static uint32_t attempts = 0;
+  if ((attempts++ % 60) == 0) {
+    ESP_LOGI(TAG, "Native RGB888 eligibility: software_rgb888=%d engine=%d", this->software_rgb888_,
+             this->rgb_conversion_client_ != nullptr);
+  }
+  if (!this->software_rgb888_ || this->rgb_conversion_client_ == nullptr || source == nullptr || presented == nullptr ||
+      in_w < 16 || in_h < 4 || x < 0 || y < 0 || out_w < 1 || out_h < 1 || x + out_w > this->width_ ||
+      y + out_h > this->height_ || (reinterpret_cast<uintptr_t>(source) & 15) != 0 || !this->wait_for_frame_buffer_())
+    return false;
+  const int64_t native_started = esp_timer_get_time();
+  portENTER_CRITICAL(&this->frame_buffer_lock_);
+  const uint8_t back = this->frame_buffer_handoff_.back_index();
+  portEXIT_CRITICAL(&this->frame_buffer_lock_);
+  uint8_t *target = this->frame_buffers_[back];
+  // Only the letterbox needs clearing. PPA replaces every visible pixel.
+  for (int row = 0; row < this->height_; ++row) {
+    uint8_t *line = target + size_t(row) * this->width_ * 3;
+    if (row < y || row >= y + out_h) {
+      std::memset(line, 0, this->width_ * 3);
+    } else {
+      std::memset(line, 0, x * 3);
+      std::memset(line + (x + out_w) * 3, 0, (this->width_ - x - out_w) * 3);
+    }
+  }
+  const int64_t convert_started = esp_timer_get_time();
+  if (!this->convert_rgb565_to_rgb888_(reinterpret_cast<const uint8_t *>(source), target, x, y, in_w, in_h, 0, 0, 0,
+                                       false, false, out_w, out_h))
+    return false;
+  const int64_t converted_at = esp_timer_get_time();
+  portENTER_CRITICAL(&this->frame_buffer_lock_);
+  this->frame_buffer_handoff_.begin(back);
+  portEXIT_CRITICAL(&this->frame_buffer_lock_);
+  const auto error = esp_lcd_panel_draw_bitmap(this->handle_, 0, 0, this->width_, this->height_, target);
+  if (error == ESP_OK) {
+    xSemaphoreTake(this->io_lock_, portMAX_DELAY);
+    *presented = target;
+  } else {
+    portENTER_CRITICAL(&this->frame_buffer_lock_);
+    this->frame_buffer_handoff_.cancel();
+    portEXIT_CRITICAL(&this->frame_buffer_lock_);
+  }
+  static int frames = 0;
+  static int64_t clear_us = 0, conversion_us = 0, submit_us = 0;
+  clear_us += convert_started - native_started;
+  conversion_us += converted_at - convert_started;
+  submit_us += esp_timer_get_time() - converted_at;
+  if (++frames == 60) {
+    ESP_LOGI(TAG, "Native RGB888: clear=%lld convert=%lld submit=%lld us per frame", (long long) (clear_us / frames),
+             (long long) (conversion_us / frames), (long long) (submit_us / frames));
+    frames = 0;
+    clear_us = conversion_us = submit_us = 0;
+  }
+  return error == ESP_OK;
+}
