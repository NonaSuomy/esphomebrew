+bool MIPI_DSI::draw_rotated_rgb565(int x, int y, int w, int h, const uint8_t *data, int x_offset, int y_offset,
+                                   int x_pad, bool big_endian) {
+  if (!this->software_rgb888_ || this->rgb_conversion_client_ == nullptr || data == nullptr || w < 16 || h < 4 ||
+      x < 0 || y < 0 || x + w > this->width_ || y + h > this->height_ || big_endian ||
+      (reinterpret_cast<uintptr_t>(data) & 15) != 0)
+    return false;
+  if (!this->wait_for_frame_buffer_())
+    return false;
+  portENTER_CRITICAL(&this->frame_buffer_lock_);
+  const uint8_t back = this->frame_buffer_handoff_.back_index();
+  portEXIT_CRITICAL(&this->frame_buffer_lock_);
+  uint8_t *target = this->frame_buffers_[back];
+  if (x != 0 || y != 0 || w != this->width_ || h != this->height_)
+    std::memcpy(target, this->frame_buffers_[back ^ 1], this->width_ * this->height_ * 3);
+  if (!this->convert_rgb565_to_rgb888_(data, target, x, y, w, h, x_offset, y_offset, x_pad, big_endian, true))
+    return false;
+  portENTER_CRITICAL(&this->frame_buffer_lock_);
+  this->frame_buffer_handoff_.begin(back);
+  portEXIT_CRITICAL(&this->frame_buffer_lock_);
+  const auto error = esp_lcd_panel_draw_bitmap(this->handle_, 0, 0, this->width_, this->height_, target);
+  if (error == ESP_OK) {
+    xSemaphoreTake(this->io_lock_, portMAX_DELAY);
+  } else {
+    portENTER_CRITICAL(&this->frame_buffer_lock_);
+    this->frame_buffer_handoff_.cancel();
+    portEXIT_CRITICAL(&this->frame_buffer_lock_);
+  }
+  return error == ESP_OK;
+}
+
+bool MIPI_DSI::convert_rgb565_to_rgb888_(const uint8_t *source, uint8_t *target, int x, int y, int w, int h,
+                                         int x_offset, int y_offset, int x_pad, bool big_endian, bool rotate,
+                                         int dest_w, int dest_h) {
+  // Preserve the bytewise path for tiny/unaligned overlays and big-endian
+  // sources. Full app/LVGL frames use DMA-capable aligned PSRAM buffers.
+  if (big_endian || w < 16 || h < 4 || (reinterpret_cast<uintptr_t>(source) & 15) != 0 || x_offset < 0 ||
+      y_offset < 0 || x_pad < 0)
+    return false;
+  if (this->rgb_conversion_client_ == nullptr)
+    return false;
+  // IDF SRM publishes the input cache and invalidates its output window.
+  const int stride = x_offset + w + x_pad;
+  const size_t output_bytes = this->width_ * this->height_ * 3;
+  // Partial updates copied the front buffer above; publish those untouched
+  // pixels before DMA writes just the changed rectangle.
+  esp_cache_msync(target, output_bytes, ESP_CACHE_MSYNC_FLAG_DIR_C2M | ESP_CACHE_MSYNC_FLAG_UNALIGNED);
+  ppa_srm_oper_config_t config{};
+  config.in.buffer = const_cast<uint8_t *>(source);
+  config.in.pic_w = stride;
+  config.in.pic_h = h + y_offset;
+  config.in.block_w = w;
+  config.in.block_h = h;
+  config.in.block_offset_x = x_offset;
+  config.in.block_offset_y = y_offset;
+  config.in.srm_cm = PPA_SRM_COLOR_MODE_RGB565;
+  config.out.buffer = target;
+  config.out.buffer_size = output_bytes;
+  config.out.pic_w = this->width_;
+  config.out.pic_h = this->height_;
+  config.out.block_offset_x = x;
+  config.out.block_offset_y = y;
+  config.out.srm_cm = PPA_SRM_COLOR_MODE_RGB888;
+  config.rotation_angle = rotate ? PPA_SRM_ROTATION_ANGLE_180 : PPA_SRM_ROTATION_ANGLE_0;
+  config.scale_x = dest_w > 0 ? float(dest_w) / w : 1;
+  config.scale_y = dest_h > 0 ? float(dest_h) / h : 1;
+  config.mode = PPA_TRANS_MODE_BLOCKING;
+  if (ppa_do_scale_rotate_mirror(this->rgb_conversion_client_, &config) != ESP_OK)
+    return false;
+  return true;
+}
