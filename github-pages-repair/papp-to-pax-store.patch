+    suffix = ".papp" if Path(app.get("file", "")).suffix == ".papp" else ".pax"
+    archived = f"{app['name']}-{app['version']}{suffix}"
+    return f"https://github.com/{repo}/releases/download/{release_tag(app)}/{archived}"
 
 
