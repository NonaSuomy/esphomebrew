diff --git a/components/quake2/source/other/q_hunk.c b/components/quake2/source/other/q_hunk.c
--- a/components/quake2/source/other/q_hunk.c
+++ b/components/quake2/source/other/q_hunk.c
@@ -148,12 +148,46 @@ void *Hunk_Alloc(int size) {
 void *Hunk_Alloc(int size) {
   // round to cacheline
   size = (size + 31) & ~31;
 
   cursize += size;
   if (cursize > hunkmaxsize)
     Sys_Error("Hunk_Alloc overflow");
 
   return (void *)(membase + cursize - size);
 }
+
+void *Hunk_AllocBlock(int size) {
+  int i, best = -1, bestsize = 0x7fffffff, rem;
+  size = (size + 31) & ~31;
+  if (!numblocks) {
+    blocks[0].start = hunk_pool;
+    blocks[0].size = HUNK_POOL_SIZE;
+    blocks[0].used = 0;
+    numblocks = 1;
+  }
+  for (i = 0; i < numblocks; i++)
+    if (!blocks[i].used && blocks[i].size >= size && blocks[i].size < bestsize) {
+      best = i; bestsize = blocks[i].size;
+    }
+  if (best < 0) return NULL;
+  blocks[best].used = 1;
+  rem = blocks[best].size - size;
+  if (rem >= HUNK_MIN_SPLIT && numblocks < HUNK_MAX_BLOCKS) {
+    memmove(&blocks[best + 2], &blocks[best + 1],
+            (numblocks - best - 1) * sizeof(hunkblock_t));
+    blocks[best + 1].start = blocks[best].start + size;
+    blocks[best + 1].size = rem;
+    blocks[best + 1].used = 0;
+    blocks[best].size = size;
+    numblocks++;
+  } else blocks[best].size = size;
+  memset(blocks[best].start, 0, size);
+  return blocks[best].start;
+}
+
+int Hunk_Contains(void *p) {
+  return p && (unsigned char *)p >= hunk_pool &&
+         (unsigned char *)p < hunk_pool + HUNK_POOL_SIZE;
+}
 
 int Hunk_End(void) {
