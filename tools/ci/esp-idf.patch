+static inline bool usb_dwc_ll_is_hs_controller(usb_dwc_dev_t *hw)
+{
+    return hw == &USB_DWC_HS;
+}
+
+/**
+ * @brief Configure HS UTMI port for FS/LS-only host mode (HCFG.FSLSSupp)
+ *
+ * This skips the HS chirp so FS/LS devices behind a TT hub can enumerate.
+ * The controller may clear FSLSSupp during reset, so this is also reapplied
+ * immediately before each port reset.
+ */
+static inline void usb_dwc_ll_hcfg_init_hs_fsls_host(usb_dwc_dev_t *hw)
 {
     hw->hcfg_reg.fslssupp = 1;
+    hw->hcfg_reg.fslspclksel = 0; // UTMI 16-bit interface: 30 MHz
+}
+
+/**
+ * @brief Select the UTMI FS/LS clock after the port speed is known.
+ */
+static inline void usb_dwc_ll_hcfg_set_utmi_fsls_phy_clock(usb_dwc_dev_t *hw)
+{
+    // Keep the P4 HS USB-A root controller on the FS/LS 30 MHz UTMI clock.
+    // PrtSpd can transiently read LOW while an FS hub is completing reset;
+    // selecting the 6 MHz LS clock here breaks the root link. Downstream LS
+    // devices are selected per channel using LSpdDev and TT split phases.
+    hw->hcfg_reg.fslspclksel = 0;
+}
+
+/**
+ * @brief Set the UTMI FS/LS host frame interval after the port speed is known.
+ */
+static inline void usb_dwc_ll_hfir_set_utmi_frame_interval(usb_dwc_dev_t *hw)
+{
+    usb_dwc_hfir_reg_t hfir;
+    hfir.val = hw->hfir_reg.val;
+    hfir.hfirrldctrl = 0;
+    // Keep the root controller on the FS frame clock; TT handles LS pipes.
+    hfir.frint = 29999;
+    hw->hfir_reg.val = hfir.val;
 }
 
