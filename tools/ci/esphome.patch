+#ifdef USE_ESP_IDF
+void SdMmc::unmount() {
+  if (this->card_ == nullptr) {
+    ESP_LOGW(TAG, "SD card already unmounted");
+    return;
+  }
+  esp_err_t ret;
+#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(6, 0, 0)
+  ret = esp_vfs_fat_sdcard_unmount(MOUNT_POINT.c_str(), this->card_);
+#else
+  ret = esp_vfs_fat_sdmmc_unmount();
+#endif
+  if (ret == ESP_OK) {
+    this->card_ = nullptr;
+    ESP_LOGI(TAG, "SD card unmounted safely");
+    // Do not immediately issue the next CMD0/CMD8 sequence on a card that
+    // has just been stopped.  This is especially important for exFAT cards,
+    // which may still be completing their final filesystem flush.
+    vTaskDelay(pdMS_TO_TICKS(150));
+  } else {
+    ESP_LOGE(TAG, "Failed to unmount SD card: %s", esp_err_to_name(ret));
+  }
+}
+#else
+void SdMmc::unmount() { ESP_LOGW(TAG, "unmount() not supported on this platform"); }
+#endif
