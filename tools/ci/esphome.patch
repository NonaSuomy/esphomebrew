+size_t SdMmc::file_size(const char *path) {
+  std::string absolut_path = build_path(path);
+  struct stat info;
+  size_t file_size = 0;
+  if (stat(absolut_path.c_str(), &info) < 0) {
+    ESP_LOGE(TAG, "Failed to stat file: %s", strerror(errno));
+    return -1;
+  }
+  return info.st_size;
+}
