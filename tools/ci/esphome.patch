+                id: dynamic_bar_chart
+                x: 20
+                y: 50
+                width: 440
+                height: 220
+                type: BAR
+                point_count: 12
+                update_mode: SHIFT
+                bg_color: 0x16213e
+                border_width: 1
+                border_color: 0x1f4068
+                div_line_count_hor: 5
+                div_line_count_ver: 12
+                items:
+                  bg_opa: 80%
+                axis_primary_y:
+                  min_value: 0
+                  max_value: 500
+                series:
