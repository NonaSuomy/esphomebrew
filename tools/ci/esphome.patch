+                    text_font: roboto_14_bold
+                  - text: " for "
+                    text_color: 0x000000
+                  - text: "sensor"
+                    text_color: 0x2196F3
+                    text_decor: UNDERLINE
+
+            # Example 6: Code Snippet
+            - spangroup:
+                id: code_snippet
+                x: 10
+                y: 380
+                width: 460
+                mode: BREAK
+                bg_color: 0x263238
+                pad_all: 12
