+std::string SdMmc::sd_card_type() const {
+  if (this->card_->is_sdio) {
+    return "SDIO";
+  } else if (this->card_->is_mmc) {
+    return "MMC";
+  } else {
+    return (this->card_->ocr & SD_OCR_SDHC_CAP) ? "SDHC/SDXC" : "SDSC";
+  }
+  return "UNKNOWN";
+}
