+            width: 150
+            height: 80
+            radius: 12
+            bg_color: white
+            # Regular shadow (old)
+            shadow_width: 20
+            shadow_offset_y: 5
+            shadow_color: 0x000000
+            shadow_opa: 30%
+            widgets:
