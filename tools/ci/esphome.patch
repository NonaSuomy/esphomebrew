+def _patch_managed_lvgl_include_path() -> None:
+    """Expose the parent of the managed LVGL component to ESP-IDF.
+
+    The ESP-IDF component is stored as ``.../lvgl/lvgl``.  LVGL's generated
+    sources include the public header as ``lvgl/lvgl.h``, while the package's
+    include path points at the inner directory.  ESPHome's native ESP-IDF
+    toolchain does not run PlatformIO ``extra_scripts``, so add a forwarding
+    header at the qualified path while the managed component is available.
+    """
+    config_dir = CORE.config_path.parent
+    managed_roots = (
+        config_dir / ".esphome" / "pio_components" / "idf",
+        config_dir / "managed_components",
+    )
+    for managed_root in managed_roots:
+        if not managed_root.exists():
+            continue
+        for cmake_file in managed_root.rglob("CMakeLists.txt"):
+            if cmake_file.parent.name != "lvgl" or cmake_file.parent.parent.name != "lvgl":
+                continue
+            source = cmake_file.read_text()
+            if "src/font/lv_font_montserrat_20.c" not in source:
+                continue
+            component_dir = cmake_file.parent
+            public_header = component_dir / "lvgl.h"
+            qualified_header = component_dir / "lvgl" / "lvgl.h"
+            if public_header.is_file() and not qualified_header.exists():
+                qualified_header.parent.mkdir(parents=True, exist_ok=True)
+                qualified_header.write_text(
+                    "#pragma once\n"
+                    "// ESPHome compatibility for LVGL's qualified include path.\n"
+                    '#include "../lvgl.h"\n'
+                )
+                print(f"LVGL/ESP-IDF: added qualified header at {qualified_header}")
+            old = 'INCLUDE_DIRS "." "src"'
+            new = 'INCLUDE_DIRS ".." "." "src"'
+            if old in source and new not in source:
+                cmake_file.write_text(source.replace(old, new, 1))
+                print(f"LVGL/ESP-IDF: fixed include path in {cmake_file}")
+CONF_USE_PPA = "use_ppa"
+CONF_USE_PPA_IMG = "use_ppa_img"
+
+
+SIMPLE_TRIGGERS = (
+    df.CONF_ON_PAUSE,
+    df.CONF_ON_RESUME,
+    df.CONF_ON_DRAW_START,
+    df.CONF_ON_DRAW_END,
+)
+
+
+def as_macro(macro, value):
+    if value is None:
+        return f"#define {macro}"
+    return f"#define {macro} {value}"
+
+
+LV_CONF_FILENAME = "lv_conf.h"
