+              char buf[16];
+              snprintf(buf, sizeof(buf), "%.1f°C", x);
+              lv_span_set_text(span2, buf);
+              lv_style_set_text_color(&span2->style, lv_color_hex(x > 30 ? 0xFF0000 : 0x00AA00));
