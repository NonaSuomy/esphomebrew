@@ -0,0 +1,36 @@
+#include "i2s_audio.h"
+
+#ifdef USE_ESP32
+
+#include "esphome/core/log.h"
+
+namespace esphome {
+namespace i2s_audio {
+
+static const char *const TAG = "i2s_audio";
+
+void I2SAudioComponent::setup() {
+  // ESP-IDF 6.1 removed the i2s_port_t typedef; port IDs remain integer
+  // values and the I2S_NUM_* macros are still available.
+  static int next_port_num = I2S_NUM_0;
+#ifndef SOC_I2S_NUM
+  // ESP-IDF 6.1 no longer exports SOC_I2S_NUM through the driver headers.
+  // ESP32-P4 has three I2S controllers.
+  constexpr int kI2sPortCount = 3;
+#else
+  constexpr int kI2sPortCount = SOC_I2S_NUM;
+#endif
+  if (next_port_num >= kI2sPortCount) {
+    ESP_LOGE(TAG, "Too many components");
+    this->mark_failed();
+    return;
+  }
+
+  this->port_ = next_port_num;
+  next_port_num++;
+}
+
+}  // namespace i2s_audio
+}  // namespace esphome
+
+#endif  // USE_ESP32
