        const length=this.buffer[8],total=10+length;
        if (this.buffer.length<total) break;
        const packet=this.buffer.slice(0,total);
        if (length>=2 && packet.slice(0,-1).reduce((sum,v)=>(sum+v)&255,0)===packet.at(-1)) {
