  $('c6-install').disabled=true;
  try{const response=await fetch('/pax/c6/install',{method:'POST',headers:{'X-PAX-Token':token,'X-PAX-C6':c6.profile}});
    if(!response.ok)throw Error(await response.text());await c6Status();
