      ...(app.data?.files || []).map(file=>({path:target('/sd/'+file.target),url:publicURL(file.url),size:file.size,sha256:file.sha256})),
      {path:target('/sd/roms/pax/'+app.name+'.pax'),url:publicURL(app.url),size:app.size,sha256:app.sha256},
